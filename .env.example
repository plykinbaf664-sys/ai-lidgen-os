# Leadgen production limits
LEADGEN_DAILY_LEAD_LIMIT=50
LEADGEN_CAMPAIGN_COMPANY_LIMIT=50
LEADGEN_CONTACT_READY_TARGET=20
LEADGEN_CAMPAIGN_EMAIL_TARGET=50
LEADGEN_DISCOVERY_CANDIDATE_BUDGET=1200
LEADGEN_SEARCH_MAX_PAGES=10

# Search transport: browser uses public web result pages and requires no search API key.
# Other supported values: auto, yandex, tavily, yandex_tavily.
LEADGEN_SEARCH_PROVIDER=browser

# Email delivery safety and scheduling
EMAIL_TEST_MODE=
EMAIL_TEST_RECIPIENT=
EMAIL_DAILY_SEND_LIMIT=100
EMAIL_BATCH_SEND_LIMIT=50
EMAIL_MIN_DELAY_SECONDS=
EMAIL_MAX_DELAY_SECONDS=
FOLLOWUP_ENABLED=true
FOLLOWUP_AUTOMATION_ENABLED=false
FOLLOWUP_AUTOMATION_SCAN_MINUTES=15
FOLLOWUP_MIN_INTERVAL_HOURS=24
FOLLOWUP_MAX_PER_LEAD=1
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
EMAIL_BUSINESS_TIMEZONE=
OUTREACH_PROCESSOR_SECRET=
LEADGEN_BASE_URL=

# Delivery state. Defaults to local outside Vercel and Supabase on Vercel.
# Local mode bypasses Supabase and survives local restarts; do not use it on Vercel.
OUTREACH_DELIVERY_STORAGE=

# SMTP credentials (never commit real values)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Optional absolute path for persistent local Leadgen OS data.
# LEADGEN_LOCAL_DATA_DIR=C:\leadgen-data
